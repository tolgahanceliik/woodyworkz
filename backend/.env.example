# ════════════════════════════════════════════════════════════════════════════
#  WoodyWorkz AI Product Studio — Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#    cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════

# ── Zorunlu ─────────────────────────────────────────────────────────────────
# Google AI Studio'dan alın: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model seçimi (isteğe bağlı, varsayılanlar aşağıda) ──────────────────────
GEMINI_VISION_MODEL=gemini-1.5-pro
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_GEN_MODEL=imagen-3.0-generate-001

# ── Uygulama ────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development

# ── CORS (virgülle ayrılmış URL listesi olarak da verilebilir) ───────────────
# Varsayılan: http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Dosya yükleme ────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Çıktı ───────────────────────────────────────────────────────────────────
GENERATED_IMAGES_DIR=generated_images
SHOTS_PER_PRODUCT=5
